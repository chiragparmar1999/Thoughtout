{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ],
  "installCommand": "npm install --no-audit --no-fund",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs24.x",
      "maxDuration": 30
    }
  }
}